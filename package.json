{
  "name": "pasarela-pagos-cripto",
  "version": "1.0.0",
  "description": "Pasarela de pagos USDT TRC-20 con HD Wallet, QR y deteccion automatica de depositos",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "concurrently -n \"API,WEB\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node --watch src/server.js",
    "dev:web": "npm --prefix client run dev",
    "install:all": "npm install && npm --prefix client install",
    "db:setup": "node src/scripts/setupDatabase.js",
    "job:deposits": "node src/jobs/depositMonitor.js",
    "job:sweep": "node src/jobs/sweepJob.js",
    "lint": "eslint src/"
  },
  "keywords": [
    "crypto",
    "payments",
    "usdt",
    "trc20",
    "tron",
    "hd-wallet"
  ],
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "axios": "^1.7.7",
    "bcrypt": "^5.1.1",
    "bip39": "^3.1.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-slow-down": "^2.0.3",
    "hdkey": "^2.1.0",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "node-cron": "^3.0.3",
    "qrcode": "^1.5.4",
    "tronweb": "^6.0.0",
    "uuid": "^10.0.0",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "eslint": "^9.10.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true,
    "secp256k1@4.0.4": true
  }
}
